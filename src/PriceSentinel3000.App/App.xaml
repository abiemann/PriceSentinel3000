<Application x:Class="PriceSentinel3000.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PriceSentinel3000.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Styles/Containers.xaml" />
                <ResourceDictionary Source="Styles/Inputs.xaml" />
                <ResourceDictionary Source="Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:TradingModeToAngleConverter x:Key="TradingModeToAngleConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
