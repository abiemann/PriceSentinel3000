<UserControl x:Class="PriceSentinel3000.App.Views.ChartWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PriceSentinel3000.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <Border x:Name="ChartCard"
                Padding="12"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Text="{Binding SymbolDisplay}" />
                    <ComboBox Grid.Column="1"
                              MinWidth="78"
                              Height="26"
                              Margin="12,0,0,0"
                              Padding="8,3"
                              VerticalAlignment="Center"
                              FontSize="9"
                              FontWeight="SemiBold"
                              Style="{StaticResource InputComboBoxStyle}"
                              ItemsSource="{Binding ChartCandleIntervalOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding ChartCandleIntervalSeconds, Mode=TwoWay}"
                              ToolTip="Choose the displayed candle duration. Longer intervals show more history while keeping candle widths consistent. Historical charts require an exact multiple of the source interval. This control does not change the script interval or quote polling." />
                    <ToggleButton x:Name="RsiToggle"
                                  Grid.Column="3"
                                  Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ChartScaleToggleStyle}"
                                  IsChecked="{Binding ShowRsi, Mode=TwoWay}"
                                  Content="{Binding RsiToggleLabel}"
                                  ToolTip="Show or hide the 14-period simple-average RSI panel." />
                    <ToggleButton x:Name="ChartScaleToggle"
                                  Grid.Column="4"
                                  Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ChartScaleToggleStyle}"
                                  IsChecked="{Binding IsChartManualScale, Mode=TwoWay}"
                                  Content="{Binding ChartScaleLabel}"
                                  ToolTip="Auto fits incoming prices. In Manual, left-drag the upper half of the price chart to adjust its top Y value, or the lower half to adjust its bottom Y value." />
                    <TextBlock Grid.Column="5"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="BID / ASK" />
                    <TextBlock Grid.Column="6"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="16"
                               Text="{Binding BidAskDisplay}" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <ToggleButton Margin="0,0,8,4"
                                  Style="{StaticResource ChartScaleToggleStyle}"
                                  Foreground="#F4C95D"
                                  Content="EMA 50"
                                  IsChecked="{Binding ShowEma50, Mode=TwoWay}"
                                  ToolTip="50-period exponential moving average of chart candle closes. Periods follow the selected chart interval. Seeded from the first available close; synthetic gap candles are skipped." />
                    <ToggleButton Margin="0,0,8,4"
                                  Style="{StaticResource ChartScaleToggleStyle}"
                                  Foreground="#6DB8FF"
                                  Content="EMA 100"
                                  IsChecked="{Binding ShowEma100, Mode=TwoWay}"
                                  ToolTip="100-period exponential moving average of chart candle closes. Periods follow the selected chart interval. Seeded from the first available close; synthetic gap candles are skipped." />
                    <ToggleButton Margin="0,0,8,4"
                                  Style="{StaticResource ChartScaleToggleStyle}"
                                  Foreground="#C29AFF"
                                  Content="EMA 200"
                                  IsChecked="{Binding ShowEma200, Mode=TwoWay}"
                                  ToolTip="200-period exponential moving average of chart candle closes. Periods follow the selected chart interval. Seeded from the first available close; synthetic gap candles are skipped." />
                    <ToggleButton Margin="0,0,12,4"
                                  Style="{StaticResource ChartScaleToggleStyle}"
                                  Foreground="#FF92B4"
                                  Content="VWAP"
                                  IsChecked="{Binding ShowVwap, Mode=TwoWay}"
                                  ToolTip="Regular-session VWAP resets at 9:30 AM Eastern and ends at the market close, including early closes. Uses typical price (high + low + close) / 3 weighted by candle volume. Requires complete historical candles with known volume from the session open; sampled quotes and incomplete history do not produce a VWAP." />
                    <TextBlock Margin="0,0,0,4"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="10"
                               Text="{Binding VwapAvailabilityText}" />
                </WrapPanel>
                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Background="#0C131C"
                        BorderBrush="#253447"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <controls:PriceChart x:Name="Chart"
                                             Margin="1"
                                             CandleIntervalSeconds="{Binding ChartCandleIntervalSeconds}"
                                             IsManualScale="{Binding IsChecked, ElementName=ChartScaleToggle}"
                                             Points="{Binding ChartPoints}"
                                             ScaleResetVersion="{Binding ChartScaleResetVersion}"
                                             ShowRsi="{Binding IsChecked, ElementName=RsiToggle}"
                                             ShowEma50="{Binding ShowEma50}"
                                             ShowEma100="{Binding ShowEma100}"
                                             ShowEma200="{Binding ShowEma200}"
                                             ShowVwap="{Binding ShowVwap}"
                                             WindowMinutes="{Binding BufferMinutes}" />
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMarketData}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Text="WAITING FOR MARKET DATA" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="#41536A"
                                       FontSize="11"
                                       Text="Start Paper Trader or Replay to activate the chart." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                               Text="STRATEGY ENGINE" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               Text="{Binding StrategyMessage}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#71859C"
                               FontFamily="Consolas"
                               FontSize="10"
                               Text="{Binding StrategyMetrics}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="{StaticResource SecondaryControlSurfaceBrush}"
                        BorderBrush="{StaticResource SecondaryControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding StrategyStateLabel}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
