<UserControl x:Class="PriceSentinel3000.App.Views.AppHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PriceSentinel3000.App.Views">
    <Border Padding="24,0"
            Background="{StaticResource HeaderSurfaceBrush}"
            BorderBrush="{StaticResource ChromeBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="338" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Text="MARKET MONITOR / PAPER TRADING LAB" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="25"
                           FontWeight="Bold"
                           Text="PriceSentinel 3000" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Margin="0,0,20,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Margin="0,0,0,4"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Text="TOOLS" />
                <Button x:Name="RetainHighResolutionDataButton"
                        Height="34"
                        Padding="10,4"
                        Click="RetainHighResolutionDataButton_Click"
                        AutomationProperties.Name="Retain high-resolution data">
                    <Button.Style>
                        <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                            <Setter Property="ToolTip" Value="Retain high-resolution data. Automatic downloads are off." />
                            <Setter Property="AutomationProperties.ItemStatus" Value="Automatic downloads off" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutomaticDownloadEnabled, RelativeSource={RelativeSource AncestorType=views:AppHeaderView}}" Value="True">
                                    <Setter Property="ToolTip" Value="Retain high-resolution data. Automatic downloads are enabled." />
                                    <Setter Property="AutomationProperties.ItemStatus" Value="Automatic downloads enabled" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="DownloadClock"
                                Width="24"
                                Height="24"
                                Margin="0,0,8,0"
                                CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutomaticDownloadEnabled, RelativeSource={RelativeSource AncestorType=views:AppHeaderView}}" Value="True">
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Width="16" Height="16">
                                <Ellipse Stroke="{Binding Path=(TextElement.Foreground), ElementName=DownloadClock}"
                                         StrokeThickness="1.5" />
                                <Polyline Points="8,3.5 8,8 11.5,10"
                                          Stroke="{Binding Path=(TextElement.Foreground), ElementName=DownloadClock}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                            </Grid>
                        </Border>
                        <TextBlock VerticalAlignment="Center" Text="RETAIN HI-RES DATA" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <StackPanel Margin="0,0,26,0">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="SYMBOL" />
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding SymbolDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="LAST PRICE" />
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding CurrentPrice}" />
                </StackPanel>
                <Border Margin="0,0,26,0"
                        Padding="7,2"
                        Background="#342A14"
                        BorderBrush="#8A6A22"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTip="Robinhood identifies this symbol as eligible for its overnight 24/5 market.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTwentyFourHourEligible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#F4C15D"
                               FontSize="9"
                               FontWeight="Bold"
                               LineHeight="10"
                               LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Center">
                        <Run Text="24" />
                        <LineBreak />
                        <Run Text="HR" />
                    </TextBlock>
                </Border>
                <Border Padding="12,7"
                        Background="{Binding MarketDataStatusBackground}"
                        BorderBrush="{Binding MarketDataStatusBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="{Binding MarketDataStatusForeground}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding MarketDataStatus}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
