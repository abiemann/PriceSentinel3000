<UserControl x:Class="PriceSentinel3000.App.Views.AppHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="24,0"
            Background="{StaticResource HeaderSurfaceBrush}"
            BorderBrush="{StaticResource ChromeBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           Text="MARKET MONITOR / PAPER TRADING LAB" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="25"
                           FontWeight="Bold"
                           Text="PriceSentinel 3000" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <StackPanel Margin="0,0,26,0">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="SYMBOL" />
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding SymbolDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="LAST PRICE" />
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding CurrentPrice}" />
                </StackPanel>
                <Border Margin="0,0,26,0"
                        Padding="9,5"
                        VerticalAlignment="Center"
                        Background="#342A14"
                        BorderBrush="#8A6A22"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTip="Robinhood identifies this symbol as eligible for its overnight 24/5 market.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTwentyFourHourEligible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="#F4C15D"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="24HR" />
                </Border>
                <Border Padding="12,7"
                        Background="{Binding MarketDataStatusBackground}"
                        BorderBrush="{Binding MarketDataStatusBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Foreground="{Binding MarketDataStatusForeground}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding MarketDataStatus}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
