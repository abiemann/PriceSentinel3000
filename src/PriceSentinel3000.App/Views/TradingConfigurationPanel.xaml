<UserControl x:Class="PriceSentinel3000.App.Views.TradingConfigurationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PriceSentinel3000.App.Views">
    <Grid ClipToBounds="True"
          RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TranslateTransform Y="-28" />
        </Grid.RenderTransform>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="MaxHeight" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsEnabled" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfigurationPanelExpanded}"
                                 Value="True">
                        <Setter Property="MaxHeight" Value="1600" />
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="IsEnabled" Value="True" />
                        <DataTrigger.EnterActions>
                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                     From="0"
                                                     To="1600"
                                                     Duration="0:0:0.38">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0"
                                                     To="1"
                                                     Duration="0:0:0.22" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="-28"
                                                     To="0"
                                                     Duration="0:0:0.32">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                     From="1600"
                                                     To="0"
                                                     Duration="0:0:0.32">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseIn" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1"
                                                     To="0"
                                                     Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="0"
                                                     To="-28"
                                                     Duration="0:0:0.28">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseIn" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <StackPanel>
            <StackPanel x:Name="SessionInputs">
                <views:AccountConfigurationView IsEnabled="{Binding IsSessionConfigurationEditable}" />
                <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel x:Name="StrategyInputs" IsEnabled="{Binding IsSessionConfigurationEditable}">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="STRATEGY" />
                            <ComboBox x:Name="StrategySelector" Margin="0,12,0,0"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      ItemsSource="{Binding AvailableStrategies}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedItem="{Binding SelectedStrategy, Mode=OneWay}"
                                      SelectionChanged="StrategySelector_SelectionChanged"
                                      DropDownOpened="StrategySelector_DropDownOpened"
                                      ToolTip="Shared by Paper, LIVE, and Replay. Copy a compatible thinkScript strategy into the scripts folder." />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="SCRIPTS FOLDER" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenScriptsFolderCommand}" ToolTip="{Binding ScriptsDirectory}" />
                                <Button Grid.Column="2" Content="REFRESH" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RefreshScriptsCommand}" />
                            </Grid>
                            <StackPanel Margin="0,12,0,0" IsEnabled="{Binding IsExternalStrategySelected}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Script candle interval" />
                                <ComboBox x:Name="ScriptBarIntervalSelector" ItemsSource="{Binding ScriptBarIntervalOptions}"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding ScriptBarIntervalSeconds, Mode=TwoWay}"
                                          ToolTip="Scripts evaluate completed price candles. This interval is independent of the chart display." />
                                <TextBlock x:Name="TestedScriptIntervalText" Text="{Binding TestedScriptIntervalLabel}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="#AFC5DE"
                                           ToolTip="Declared in the script's PriceSentinel metadata. Selecting a script applies this interval; changing the chart interval does not change it." />
                                <TextBlock x:Name="ScriptIntervalWarningText" Text="{Binding ScriptIntervalWarning}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="#FFCA80">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasScriptIntervalMismatch}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer x:Name="ScriptDiagnosticsScrollViewer" Margin="0,8,0,0" MaxHeight="150"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasScriptDiagnostics}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ScrollViewer.ContextMenu>
                                <ContextMenu Background="{StaticResource ControlSurfaceBrush}"
                                             Foreground="{StaticResource PrimaryTextBrush}"
                                             BorderBrush="{StaticResource SecondaryControlBorderBrush}"
                                             BorderThickness="1" Padding="4" MinWidth="100" FontSize="12">
                                    <ContextMenu.Template>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </ContextMenu.Template>
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="MenuItemSurface" Padding="{TemplateBinding Padding}"
                                                                Background="Transparent" CornerRadius="3">
                                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="MenuItemSurface" Property="Background"
                                                                        Value="{StaticResource SecondaryControlSurfaceBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="Copy" Click="CopyScriptDiagnostics_Click" />
                                    <MenuItem Header="Cancel" />
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>
                            <TextBlock x:Name="ScriptDiagnosticsText" Text="{Binding ScriptDiagnostics}"
                                       TextWrapping="Wrap" Margin="0,0,8,0" FontSize="11" Foreground="#FFCA80" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <views:RiskControlsView IsEnabled="{Binding IsSessionConfigurationEditable}" />
                <views:DataTimingView IsEnabled="{Binding IsSessionConfigurationEditable}" />
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartSessionCommand}"
                        Content="{Binding PrimaryActionLabel}" />
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding StopSessionCommand}"
                        Content="{Binding SecondaryActionLabel}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
