<UserControl x:Class="PriceSentinel3000.App.Views.DataTimingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <Style x:Key="ReplayOnlyGridStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReplaySelected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReplayDateTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Padding" Value="6,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReplayAvailabilityStatus}" Value="Disk15">
                    <Setter Property="Background" Value="#176747" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReplayAvailabilityStatus}" Value="Broker15">
                    <Setter Property="Background" Value="#77D9AA" />
                    <Setter Property="Foreground" Value="#091C14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReplayAvailabilityStatus}" Value="Coarse60">
                    <Setter Property="Background" Value="#E8AB4D" />
                    <Setter Property="Foreground" Value="#241706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReplayAvailabilityStatus}" Value="Coarse120">
                    <Setter Property="Background" Value="#EC8B7C" />
                    <Setter Property="Foreground" Value="#2A1010" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Margin" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Margin="0,12,0,0"
            Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionLabelStyle}"
                       Text="DATA TIMING" />
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Buffer minutes" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="Built-In strategy lookback and chart span at 15-second candles. Longer chart intervals expand the visible time span. Allowed range: 5-15 minutes."
                             ToolTipService.ShowOnDisabled="True"
                             Text="{Binding BufferMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Quote poll (sec)" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="How often PriceSentinel requests the latest quote. Lower values update faster but make more Robinhood requests. Allowed range: 1-60 seconds."
                             ToolTipService.ShowOnDisabled="True"
                             Text="{Binding QuotePollingSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Reconcile (sec)" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="How often PriceSentinel checks Robinhood price history to verify recent candles and fill gaps. Allowed range: 15-300 seconds."
                             ToolTipService.ShowOnDisabled="True"
                             Text="{Binding ReconciliationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Lookback (sec)" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="How far back each reconciliation check requests price history. A longer window can repair older gaps but transfers more data. Allowed range: 60-3600 seconds."
                             ToolTipService.ShowOnDisabled="True"
                             Text="{Binding ReconciliationLookbackSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Completion delay (sec)" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             ToolTip="Leaves this many seconds at the newest edge out of reconciliation so Robinhood has time to finalize candles. Allowed range: 0-300 seconds."
                             ToolTipService.ShowOnDisabled="True"
                             Text="{Binding ReconciliationCompletionDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReplaySelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Replay date" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplayDateInput"
                                 Style="{StaticResource ReplayDateTextBoxStyle}"
                                 AutomationProperties.Name="Replay date, yyyy-MM-dd. Press Enter to check data availability."
                                 ToolTip="{Binding ReplayAvailabilityText}"
                                 PreviewKeyDown="OnReplaySettingsKeyDown"
                                 Text="{Binding ReplayDate, UpdateSourceTrigger=LostFocus}" />
                        <Button x:Name="ReplayCalendarButton" Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="36" Margin="3,0,0,0" Padding="0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                Content="&#xE787;" Click="OnOpenReplayCalendar"
                                AutomationProperties.Name="Choose replay date and inspect saved data"
                                ToolTip="Choose a date. Calendar colors describe the selected stock and local start/end times." />
                        <Popup x:Name="ReplayCalendarPopup" PlacementTarget="{Binding ElementName=ReplayDateInput}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               Opened="OnCalendarOpened" Closed="OnCalendarClosed">
                            <Border Width="330" Padding="12" Margin="0,4,0,0"
                                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrongControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" PreviewKeyDown="OnCalendarKeyDown">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                                               Text="{Binding Symbol, StringFormat={}{0} · replay data availability}" />
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PreviousCalendarMonthButton" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="0"
                                                Content="‹" FontSize="20" Click="OnPreviousCalendarMonth"
                                                AutomationProperties.Name="Previous month" />
                                        <TextBlock x:Name="CalendarMonthTitle" Grid.Column="1" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                        <Button x:Name="NextCalendarMonthButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="0"
                                                Content="›" FontSize="20" Click="OnNextCalendarMonth"
                                                AutomationProperties.Name="Next month" />
                                    </Grid>
                                    <UniformGrid Columns="7" Margin="0,0,0,3" TextBlock.Foreground="{StaticResource MutedTextBrush}" TextBlock.FontSize="10">
                                        <TextBlock Text="SUN" HorizontalAlignment="Center" />
                                        <TextBlock Text="MON" HorizontalAlignment="Center" />
                                        <TextBlock Text="TUE" HorizontalAlignment="Center" />
                                        <TextBlock Text="WED" HorizontalAlignment="Center" />
                                        <TextBlock Text="THU" HorizontalAlignment="Center" />
                                        <TextBlock Text="FRI" HorizontalAlignment="Center" />
                                        <TextBlock Text="SAT" HorizontalAlignment="Center" />
                                    </UniformGrid>
                                    <UniformGrid x:Name="CalendarDaysGrid" Columns="7" Rows="6" />
                                    <TextBlock x:Name="CalendarLoadingText" Margin="2,7,2,0" Foreground="{StaticResource MutedTextBrush}"
                                               Text="Checking saved coverage…" FontSize="11" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,9,0,0">
                                        <Border Background="#176747" CornerRadius="3" Padding="5,3" Margin="0,0,5,5">
                                            <TextBlock Foreground="White" FontSize="10" Text="15D · on disk" />
                                        </Border>
                                        <Border Background="#77D9AA" CornerRadius="3" Padding="5,3" Margin="0,0,5,5">
                                            <TextBlock Foreground="#091C14" FontSize="10" Text="15B · broker verified" />
                                        </Border>
                                        <Border Background="#E8AB4D" CornerRadius="3" Padding="5,3" Margin="0,0,5,5">
                                            <TextBlock Foreground="#241706" FontSize="10" Text="30–60s · coarser data" />
                                        </Border>
                                        <Border Background="#EC8B7C" CornerRadius="3" Padding="5,3" Margin="0,0,5,5">
                                            <TextBlock Foreground="#2A1010" FontSize="10" Text="2m · coarser data" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"
                                               Text="Gray: not checked, incomplete, or unavailable. Hover for details. Selecting a date checks the broker only for that date." />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Replay speed (x)" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding ReplaySpeed, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,8,0,0" Style="{StaticResource ReplayOnlyGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,8,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ReplayAvailabilityText}"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="CHECK"
                        Padding="5,4" Height="30" Click="OnCheckReplayAvailability"
                        AutomationProperties.Name="Check replay data availability"
                        ToolTip="Check the current symbol, date, and local start/end times without starting Replay." />
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReplaySelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Local start (HH:mm)" />
                    <TextBox x:Name="ReplayStartInput" Style="{StaticResource InputTextBoxStyle}"
                             PreviewKeyDown="OnReplaySettingsKeyDown"
                             Text="{Binding ReplayTime, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Local end (HH:mm)" />
                    <TextBox x:Name="ReplayEndInput" Style="{StaticResource InputTextBoxStyle}"
                             PreviewKeyDown="OnReplaySettingsKeyDown"
                             Text="{Binding ReplayEndTime, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0" Style="{StaticResource ReplayOnlyGridStyle}">
                <CheckBox x:Name="ReplayOfflineOnlyCheckBox"
                          Style="{StaticResource PaperCheckBoxStyle}"
                          Content="Replay from local files only (offline)"
                          IsChecked="{Binding DataRetention.ReplayOfflineOnly, Mode=TwoWay}"
                          IsEnabled="{Binding IsSessionConfigurationEditable}"
                          AutomationProperties.Name="Replay from local files only (offline)"
                          ToolTip="Use saved data without contacting the broker. Leave unchecked to use saved data first and request missing history from Robinhood."
                          ToolTipService.ShowOnDisabled="True" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
