<UserControl x:Class="PriceSentinel3000.App.Views.RiskControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,12,0,0"
            Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionLabelStyle}"
                       Text="RISK CONTROLS" />

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="Position size" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          ItemsSource="{Binding PositionSizeOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding PositionSizeBasis}" />
                <TextBox Grid.Column="2"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding PositionSizeValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="Trading quantity" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          ItemsSource="{Binding QuantityLimitOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding QuantityLimitMode}" />
                <TextBox Grid.Column="2"
                         IsEnabled="{Binding IsQuantityLimited}"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding MaximumQuantity, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="Maximum entries per day" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          ItemsSource="{Binding EntryLimitOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding UnlimitedEntries}" />
                <TextBox Grid.Column="2"
                         IsEnabled="{Binding IsEntryLimited}"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding MaximumEntriesPerDay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="Maximum daily loss" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          ItemsSource="{Binding DailyLossOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding MaximumDailyLossBasis}" />
                <TextBox Grid.Column="2"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding MaximumDailyLossValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource FieldLabelStyle}"
                       Text="Stop loss" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          ItemsSource="{Binding StopLossOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding StopLossBasis}" />
                <TextBox Grid.Column="2"
                         Style="{StaticResource InputTextBoxStyle}"
                         Text="{Binding StopLossValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
