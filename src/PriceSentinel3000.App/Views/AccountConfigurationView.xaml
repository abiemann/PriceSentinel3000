<UserControl x:Class="PriceSentinel3000.App.Views.AccountConfigurationView"
             x:Name="AccountConfigurationRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,12,0,0"
            Style="{StaticResource CardStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionLabelStyle}"
                       Text="{Binding AccountPanelCaption}" />
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="Symbol" />
                    <TextBox x:Name="SymbolTextBox"
                             MaxLength="10"
                             CharacterCasing="Upper"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="HandleSymbolTextChanged"
                             LostKeyboardFocus="HandleSymbolLostKeyboardFocus"
                             PreviewKeyDown="HandleSymbolPreviewKeyDown" />
                    <Popup x:Name="SymbolSuggestionsPopup"
                           AllowsTransparency="True"
                           DataContext="{Binding DataContext, ElementName=AccountConfigurationRoot}"
                           IsOpen="{Binding IsSymbolSuggestionsOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=SymbolTextBox}"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Width="320"
                                MaxHeight="272"
                                Margin="0,3,0,0"
                                Padding="3"
                                Background="#0B121B"
                                BorderBrush="{StaticResource StrongControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ListBox x:Name="SymbolSuggestionsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     ItemsSource="{Binding SymbolSuggestions}"
                                     PreviewMouseLeftButtonUp="HandleSymbolSuggestionClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="SuggestionBorder"
                                                            Padding="9,8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SuggestionBorder"
                                                                    Property="Background"
                                                                    Value="#121D2A" />
                                                            <Setter TargetName="SuggestionBorder"
                                                                    Property="BorderBrush"
                                                                    Value="#49617D" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SuggestionBorder"
                                                                    Property="Background"
                                                                    Value="#15382E" />
                                                            <Setter TargetName="SuggestionBorder"
                                                                    Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       Text="{Binding Symbol}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="{Binding AccountBalanceCaption}" />
                    <TextBox IsReadOnly="{Binding IsLiveEffective}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding AccountBalanceValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                </StackPanel>
            </Grid>
            <CheckBox Margin="0,12,0,0"
                      Content="Trades settle right away"
                      IsChecked="{Binding TradesSettleImmediately}"
                      ToolTip="Checked: paper-sale proceeds become buying power immediately. Unchecked: proceeds use simulated T+1 weekday settlement.">
                <CheckBox.Style>
                    <Style TargetType="CheckBox"
                           BasedOn="{StaticResource PaperCheckBoxStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </StackPanel>
    </Border>
</UserControl>
