<Window x:Class="PriceSentinel3000.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PriceSentinel3000.App"
        mc:Ignorable="d"
        Title="PriceSentinel 3000"
        Height="560"
        Width="920"
        MinHeight="480"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#10151D">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="#6EE7B7"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="MARKET MONITOR" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#F8FAFC"
                       FontSize="38"
                       FontWeight="Bold"
                       Text="PriceSentinel 3000" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="#94A3B8"
                       FontSize="16"
                       Text="Simulation-first price-action research and trade execution" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,34,0,34"
                Padding="28"
                Background="#17202B"
                BorderBrush="#263445"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Foreground="#CBD5E1"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="EFFECTIVE MODE" />
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="#6EE7B7"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="SIMULATION" />
                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0">
                    <TextBlock Foreground="#E2E8F0"
                               FontSize="16"
                               Text="The Visual Studio solution is ready." />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="#94A3B8"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="Market data, strategy, journal, and broker adapters will be added in the next implementation stages. Live trading is not armed in this scaffold." />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="#64748B"
                   FontSize="12"
                   Text="Experimental software — validate every strategy in simulation before considering live execution." />
    </Grid>
</Window>
