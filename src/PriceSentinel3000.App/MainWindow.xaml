<Window x:Class="PriceSentinel3000.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:PriceSentinel3000.App.Views"
        mc:Ignorable="d"
        Title="PriceSentinel 3000"
        Width="1500"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeSurfaceBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="{StaticResource BrandSurfaceBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="P" />
                    </Border>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SupportingTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="PriceSentinel 3000" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            Content="&#xE921;"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"
                            Content="&#xE922;"
                            ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="&#xE8BB;"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <views:AppHeaderView Grid.Row="1" />

        <Grid Grid.Row="2"
              Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Panel.ZIndex="2"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}"
                                       Text="OPERATING MODE" />
                            <Grid Height="240"
                                  Margin="0,10,0,0">
                                <Canvas Width="294"
                                        Height="240">
                                    <Grid Canvas.Left="91"
                                          Canvas.Top="60"
                                          Width="112"
                                          Height="112">
                                        <Ellipse Fill="#0B1119"
                                                 Stroke="#34465B"
                                                 StrokeThickness="3" />
                                        <Ellipse Margin="10"
                                                 Fill="{StaticResource ToggleSurfaceBrush}"
                                                 Stroke="#24384C"
                                                 StrokeThickness="1" />
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{Binding SelectedMode, Converter={StaticResource TradingModeToAngleConverter}}" />
                                            </Grid.RenderTransform>
                                            <Border Width="4"
                                                    Height="35"
                                                    Margin="0,14,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="2" />
                                        </Grid>
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="#0A1017"
                                                 Stroke="{StaticResource AccentBrush}"
                                                 StrokeThickness="2" />
                                    </Grid>
                                    <Button Canvas.Left="0"
                                            Canvas.Top="100"
                                            Width="80"
                                            Tag="Replay"
                                            Click="ModeButton_Click"
                                            Content="REPLAY">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}"
                                                   TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReplaySelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="92"
                                            Canvas.Top="4"
                                            Width="110"
                                            Tag="PaperTrader"
                                            Click="ModeButton_Click"
                                            Content="PAPER TRADER">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}"
                                                   TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaperTraderSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="214"
                                            Canvas.Top="100"
                                            Width="80"
                                            Tag="Live"
                                            Click="ModeButton_Click"
                                            Content="LIVE">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}"
                                                   TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                                        <Setter Property="Background" Value="#3B211E" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                                                        <Setter Property="Foreground" Value="#FF9B8C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="107"
                                            Canvas.Top="200"
                                            Width="80"
                                            Tag="Off"
                                            Click="ModeButton_Click"
                                            Content="OFF">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}"
                                                   TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOffSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <views:TradingConfigurationPanel Panel.ZIndex="1" />
                </StackPanel>
            </ScrollViewer>

            <views:ChartWorkspaceView Grid.Column="2" />
            <views:SessionSidebarView Grid.Column="4" />
        </Grid>

        <views:AppStatusBarView Grid.Row="3" />
    </Grid>
</Window>
