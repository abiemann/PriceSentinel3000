<Window x:Class="PriceSentinel3000.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PriceSentinel 3000"
        Width="1500"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,0"
                Background="#101721"
                BorderBrush="#243143"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="MARKET MONITOR / SIMULATION LAB" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="25"
                               FontWeight="Bold"
                               Text="PriceSentinel 3000" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="SYMBOL" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="{Binding SymbolDisplay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="LAST PRICE" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="{Binding CurrentPrice}" />
                    </StackPanel>
                    <Border Padding="12,7"
                            Background="#34251A"
                            BorderBrush="#7B5426"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="#F4B45E"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Text="{Binding MarketDataStatus}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}"
                                       Text="OPERATING MODE" />
                            <Grid Height="240" Margin="0,10,0,0">
                                <Canvas Width="294" Height="240">
                                    <Grid Canvas.Left="91" Canvas.Top="60" Width="112" Height="112">
                                        <Ellipse Fill="#0B1119" Stroke="#34465B" StrokeThickness="3" />
                                        <Ellipse Margin="10" Fill="#182433" Stroke="#24384C" StrokeThickness="1" />
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{Binding SelectedMode, Converter={StaticResource TradingModeToAngleConverter}}" />
                                            </Grid.RenderTransform>
                                            <Border Width="4"
                                                    Height="35"
                                                    Margin="0,14,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="2" />
                                        </Grid>
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="#0A1017"
                                                 Stroke="{StaticResource AccentBrush}"
                                                 StrokeThickness="2" />
                                    </Grid>
                                    <Button Canvas.Left="0" Canvas.Top="100" Width="80"
                                            Tag="Replay" Click="ModeButton_Click" Content="REPLAY">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReplaySelected}" Value="True">
                                                        <Setter Property="Background" Value="#153D32" />
                                                        <Setter Property="BorderBrush" Value="#2BC48A" />
                                                        <Setter Property="Foreground" Value="#77F0C1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="101" Canvas.Top="4" Width="92"
                                            Tag="Simulation" Click="ModeButton_Click" Content="SIMULATION">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSimulationSelected}" Value="True">
                                                        <Setter Property="Background" Value="#153D32" />
                                                        <Setter Property="BorderBrush" Value="#2BC48A" />
                                                        <Setter Property="Foreground" Value="#77F0C1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="214" Canvas.Top="100" Width="80"
                                            Tag="Live" Click="ModeButton_Click" Content="LIVE">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                                        <Setter Property="Background" Value="#3B211E" />
                                                        <Setter Property="BorderBrush" Value="#B95145" />
                                                        <Setter Property="Foreground" Value="#FF9B8C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="107" Canvas.Top="200" Width="80"
                                            Tag="Off" Click="ModeButton_Click" Content="OFF">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOffSelected}" Value="True">
                                                        <Setter Property="Background" Value="#153D32" />
                                                        <Setter Property="BorderBrush" Value="#2BC48A" />
                                                        <Setter Property="Foreground" Value="#77F0C1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SIMULATION ACCOUNT" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Symbol" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" MaxLength="10"
                                             Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Starting balance" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding StartingBalance, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="RISK CONTROLS" />

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Position size" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding PositionSizeOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding PositionSizeBasis}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding PositionSizeValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Text="Maximum entries per day" />
                                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                          Foreground="#CBD5E1" IsChecked="{Binding UnlimitedEntries}"
                                          Content="Unlimited" />
                            </Grid>
                            <TextBox Text="{Binding MaximumEntriesPerDay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource InputTextBoxStyle}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnlimitedEntries}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Maximum daily loss" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding DailyLossOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding MaximumDailyLossBasis}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding MaximumDailyLossValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Stop loss" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding StopLossOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding StopLossBasis}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding StopLossValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DATA TIMING" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Buffer minutes" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding BufferMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Quote poll (sec)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding QuotePollingSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Reconcile (sec)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReconciliationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Overlap (sec)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReconciliationOverlapSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartSimulationCommand}"
                                Content="START SIMULATION" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StopSimulationCommand}" Content="STOP" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="160" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="104" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="5 SECOND PRICE ACTION" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="20" FontWeight="Bold" Text="{Binding SymbolDisplay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource SectionLabelStyle}" Text="BID / ASK" />
                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Right"
                                           Foreground="#CBD5E1" FontSize="16" Text="-- / --" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,18,0,0"
                                Background="#0C131C" BorderBrush="#253447"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <UniformGrid Rows="5" IsHitTestVisible="False">
                                    <Border BorderBrush="#192636" BorderThickness="0,0,0,1" />
                                    <Border BorderBrush="#192636" BorderThickness="0,0,0,1" />
                                    <Border BorderBrush="#192636" BorderThickness="0,0,0,1" />
                                    <Border BorderBrush="#192636" BorderThickness="0,0,0,1" />
                                    <Border />
                                </UniformGrid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" Foreground="#5F728A"
                                               FontSize="12" FontWeight="Bold"
                                               Text="WAITING FOR MARKET DATA" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#41536A" FontSize="11"
                                               Text="The chart will activate when a data adapter is connected." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SERIAL RING BUFFER" />
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelStyle}"
                                       Text="{Binding BufferCaption}" />
                        </Grid>
                        <ItemsControl Grid.Row="1" Margin="0,14,0,0"
                                      ItemsSource="{Binding BufferSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3,0" Padding="8"
                                            Background="#101925" BorderBrush="#304158"
                                            BorderThickness="1" CornerRadius="6">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" Foreground="#CBD5E1"
                                                       FontSize="12" FontWeight="Bold" Text="{Binding Label}" />
                                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                                                       Foreground="#52677F" FontSize="9" Text="{Binding State}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="STRATEGY ENGINE" />
                            <TextBlock Margin="0,6,0,0" Foreground="#CBD5E1" FontSize="14"
                                       Text="Signals are disabled until market data is connected." />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,7" VerticalAlignment="Center"
                                Background="#202B39" BorderBrush="#3A4B61"
                                BorderThickness="1" CornerRadius="6">
                            <TextBlock Foreground="#8EA0B7" FontSize="10"
                                       FontWeight="Bold" Text="IDLE" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SESSION STATUS" />
                            <Border Grid.Column="1" Padding="9,5"
                                    Background="{Binding SessionStateBackground}"
                                    BorderBrush="{Binding SessionStateBorder}"
                                    BorderThickness="1" CornerRadius="5">
                                <TextBlock Foreground="{Binding SessionStateForeground}" FontSize="9"
                                           FontWeight="Bold" Text="{Binding SessionStateLabel}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Effective mode" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" Text="{Binding EffectiveModeLabel}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Buying power" />
                            <TextBlock Grid.Column="1" Foreground="#CBD5E1"
                                       FontWeight="SemiBold" Text="{Binding BuyingPowerDisplay}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Broker execution" />
                            <TextBlock Grid.Column="1" Foreground="#FF8A78" FontSize="11"
                                       FontWeight="Bold" Text="{Binding LiveStateLabel}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Market data" />
                            <TextBlock Grid.Column="1" Foreground="#F4B45E" FontSize="11"
                                       FontWeight="Bold" Text="OFFLINE" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ACTIVITY JOURNAL" />
                        <ListBox Grid.Row="1" Margin="0,14,0,0" Padding="0"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding ActivityLog}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,9" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="#101925"
                                            BorderBrush="#243247" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#5F728A" FontFamily="Consolas"
                                                       FontSize="10" Text="{Binding Time}" />
                                            <TextBlock Grid.Column="1" Foreground="#B8C5D4" FontSize="11"
                                                       LineHeight="16" TextWrapping="Wrap"
                                                       Text="{Binding Message}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,0"
                Background="#101721"
                BorderBrush="#243143"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#F4B45E" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#91A2B7"
                           FontSize="11"
                           Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="#53657B"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="STAGE 2 · CONTROL SURFACE" />
            </Grid>
        </Border>
    </Grid>
</Window>
