<Window x:Class="PriceSentinel3000.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:PriceSentinel3000.App.Controls"
        mc:Ignorable="d"
        Title="PriceSentinel 3000"
        Width="1500"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0A1018"
                BorderBrush="#243143"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="#123528"
                            BorderBrush="#5EE6B1"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#5EE6B1"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="P" />
                    </Border>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#B8C5D4"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="PriceSentinel 3000" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            Content="&#xE921;"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"
                            Content="&#xE922;"
                            ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="&#xE8BB;"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="24,0"
                Background="#101721"
                BorderBrush="#243143"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="MARKET MONITOR / PAPER TRADING LAB" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="25"
                               FontWeight="Bold"
                               Text="PriceSentinel 3000" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="SYMBOL" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="{Binding SymbolDisplay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="LAST PRICE" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Text="{Binding CurrentPrice}" />
                    </StackPanel>
                    <Border Padding="12,7"
                            Background="{Binding MarketDataStatusBackground}"
                            BorderBrush="{Binding MarketDataStatusBorder}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="{Binding MarketDataStatusForeground}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Text="{Binding MarketDataStatus}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Panel.ZIndex="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}"
                                       Text="OPERATING MODE" />
                            <Grid Height="240" Margin="0,10,0,0">
                                <Canvas Width="294" Height="240">
                                    <Grid Canvas.Left="91" Canvas.Top="60" Width="112" Height="112">
                                        <Ellipse Fill="#0B1119" Stroke="#34465B" StrokeThickness="3" />
                                        <Ellipse Margin="10" Fill="#182433" Stroke="#24384C" StrokeThickness="1" />
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{Binding SelectedMode, Converter={StaticResource TradingModeToAngleConverter}}" />
                                            </Grid.RenderTransform>
                                            <Border Width="4"
                                                    Height="35"
                                                    Margin="0,14,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="2" />
                                        </Grid>
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="#0A1017"
                                                 Stroke="{StaticResource AccentBrush}"
                                                 StrokeThickness="2" />
                                    </Grid>
                                    <Button Canvas.Left="0" Canvas.Top="100" Width="80"
                                            Tag="Replay" Click="ModeButton_Click" Content="REPLAY">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReplaySelected}" Value="True">
                                                        <Setter Property="Background" Value="#153D32" />
                                                        <Setter Property="BorderBrush" Value="#2BC48A" />
                                                        <Setter Property="Foreground" Value="#77F0C1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="92" Canvas.Top="4" Width="110"
                                            Tag="PaperTrader" Click="ModeButton_Click" Content="PAPER TRADER">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaperTraderSelected}" Value="True">
                                                        <Setter Property="Background" Value="#153D32" />
                                                        <Setter Property="BorderBrush" Value="#2BC48A" />
                                                        <Setter Property="Foreground" Value="#77F0C1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="214" Canvas.Top="100" Width="80"
                                            Tag="Live" Click="ModeButton_Click" Content="LIVE">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                                        <Setter Property="Background" Value="#3B211E" />
                                                        <Setter Property="BorderBrush" Value="#B95145" />
                                                        <Setter Property="Foreground" Value="#FF9B8C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Canvas.Left="107" Canvas.Top="200" Width="80"
                                            Tag="Off" Click="ModeButton_Click" Content="OFF">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ModeButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOffSelected}" Value="True">
                                                        <Setter Property="Background" Value="#153D32" />
                                                        <Setter Property="BorderBrush" Value="#2BC48A" />
                                                        <Setter Property="Foreground" Value="#77F0C1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Panel.ZIndex="1"
                          ClipToBounds="True"
                          RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="-28" />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="MaxHeight" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfigurationPanelExpanded}"
                                                 Value="True">
                                        <Setter Property="MaxHeight" Value="1600" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsEnabled" Value="True" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                     From="0" To="1600"
                                                                     Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1"
                                                                     Duration="0:0:0.22" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="-28" To="0"
                                                                     Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                     From="1600" To="0"
                                                                     Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0"
                                                                     Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="0" To="-28"
                                                                     Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{Binding AccountPanelCaption}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Symbol" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}" MaxLength="10"
                                             CharacterCasing="Upper"
                                             Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding AccountBalanceCaption}" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="{Binding IsLiveEffective}"
                                             Text="{Binding AccountBalanceValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="RISK CONTROLS" />

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Position size" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding PositionSizeOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding PositionSizeBasis}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding PositionSizeValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Trading quantity" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding QuantityLimitOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding QuantityLimitMode}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         IsEnabled="{Binding IsQuantityLimited}"
                                         Text="{Binding MaximumQuantity, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="Maximum entries per day" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding EntryLimitOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding UnlimitedEntries}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         IsEnabled="{Binding IsEntryLimited}"
                                         Text="{Binding MaximumEntriesPerDay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Maximum daily loss" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding DailyLossOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding MaximumDailyLossBasis}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding MaximumDailyLossValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Stop loss" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                          ItemsSource="{Binding StopLossOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding StopLossBasis}" />
                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding StopLossValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DATA TIMING" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Buffer minutes" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding BufferMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Quote poll (sec)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding QuotePollingSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Reconcile (sec)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReconciliationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Overlap (sec)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReconciliationOverlapSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Replay date (yyyy-MM-dd)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReplayDate, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Replay speed (x)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReplaySpeed, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Local start (HH:mm)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReplayTime, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Local end (HH:mm)" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding ReplayEndTime, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartSessionCommand}"
                                Content="{Binding PrimaryActionLabel}" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding StopSessionCommand}"
                                Content="{Binding SecondaryActionLabel}" />
                    </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="160" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>

                <Border Padding="12" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="20" FontWeight="Bold"
                                       Text="{Binding SymbolDisplay}" />
                            <TextBlock Grid.Column="1" Margin="12,2,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Text="{Binding PriceActionCaption}" />
                            <ToggleButton x:Name="RsiToggle"
                                           Grid.Column="3" Margin="0,0,14,0"
                                           VerticalAlignment="Center"
                                          Style="{StaticResource ChartScaleToggleStyle}"
                                           IsChecked="{Binding ShowRsi, Mode=TwoWay}"
                                           Content="{Binding RsiToggleLabel}"
                                           ToolTip="Show or hide the 14-period simple-average RSI panel." />
                            <ToggleButton x:Name="ChartScaleToggle"
                                          Grid.Column="4" Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                           Style="{StaticResource ChartScaleToggleStyle}"
                                           IsChecked="{Binding IsChartManualScale, Mode=TwoWay}"
                                           Content="{Binding ChartScaleLabel}"
                                           ToolTip="Auto fits incoming prices. In Manual, left-drag the upper half of the price chart to adjust its top Y value, or the lower half to adjust its bottom Y value." />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Text="BID / ASK" />
                            <TextBlock Grid.Column="6" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#CBD5E1" FontSize="16"
                                       Text="{Binding BidAskDisplay}" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,8,0,0"
                                Background="#0C131C" BorderBrush="#253447"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                 <controls:PriceChart Margin="1"
                                                      IsManualScale="{Binding IsChecked, ElementName=ChartScaleToggle}"
                                                      Points="{Binding ChartPoints}"
                                                      ScaleResetVersion="{Binding ChartScaleResetVersion}"
                                                      ShowRsi="{Binding IsChecked, ElementName=RsiToggle}"
                                                      WindowMinutes="{Binding BufferMinutes}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMarketData}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center" Foreground="#5F728A"
                                               FontSize="12" FontWeight="Bold"
                                               Text="WAITING FOR MARKET DATA" />
                                    <TextBlock Margin="0,7,0,0" Foreground="#41536A" FontSize="11"
                                               Text="Start Paper Trader or Replay to activate the chart." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SERIAL RING BUFFER" />
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionLabelStyle}"
                                       Text="{Binding BufferCaption}" />
                        </Grid>
                        <ItemsControl Grid.Row="1" Margin="0,14,0,0"
                                      ItemsSource="{Binding BufferSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3,0" Padding="8"
                                            Background="#101925" BorderBrush="#304158"
                                            BorderThickness="1" CornerRadius="6">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" Foreground="#CBD5E1"
                                                       FontSize="12" FontWeight="Bold" Text="{Binding Label}" />
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                                       Foreground="{Binding Foreground}" FontSize="9"
                                                       FontWeight="Bold" Text="{Binding State}" />
                                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center"
                                                       Foreground="#CBD5E1" FontSize="10"
                                                       Text="{Binding Price}" />
                                            <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                                       Foreground="#647990" FontSize="8"
                                                       Text="{Binding Detail}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="STRATEGY ENGINE" />
                            <TextBlock Margin="0,6,0,0" Foreground="#CBD5E1" FontSize="14"
                                       TextTrimming="CharacterEllipsis" Text="{Binding StrategyMessage}" />
                            <TextBlock Margin="0,6,0,0" Foreground="#71859C" FontFamily="Consolas"
                                       FontSize="10" Text="{Binding StrategyMetrics}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,7" VerticalAlignment="Center"
                                Background="#202B39" BorderBrush="#3A4B61"
                                BorderThickness="1" CornerRadius="6">
                            <TextBlock Foreground="#8EA0B7" FontSize="10"
                                       FontWeight="Bold" Text="{Binding StrategyStateLabel}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="338" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SESSION STATUS" />
                            <Border Grid.Column="1" Padding="9,5"
                                    Background="{Binding SessionStateBackground}"
                                    BorderBrush="{Binding SessionStateBorder}"
                                    BorderThickness="1" CornerRadius="5">
                                <TextBlock Foreground="{Binding SessionStateForeground}" FontSize="9"
                                           FontWeight="Bold" Text="{Binding SessionStateLabel}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Effective mode" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" Text="{Binding EffectiveModeLabel}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Buying power" />
                            <TextBlock Grid.Column="1" Foreground="#CBD5E1"
                                       FontWeight="SemiBold" Text="{Binding BuyingPowerDisplay}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SessionEquityCaption}" />
                            <TextBlock Grid.Column="1" Foreground="#CBD5E1"
                                       FontWeight="SemiBold" Text="{Binding AccountEquityDisplay}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Position" />
                            <TextBlock Grid.Column="1" Foreground="#CBD5E1" FontSize="11"
                                       FontWeight="SemiBold" Text="{Binding PositionDisplay}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="P&amp;L (R / U)" />
                            <TextBlock Grid.Column="1" Foreground="#CBD5E1" FontSize="11"
                                       FontWeight="SemiBold" Text="{Binding ProfitLossDisplay}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Entries" />
                            <TextBlock Grid.Column="1" Foreground="#CBD5E1"
                                       FontWeight="SemiBold" Text="{Binding EntriesDisplay}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Broker execution" />
                            <TextBlock Grid.Column="1" Foreground="{Binding BrokerExecutionForeground}" FontSize="11"
                                       FontWeight="Bold" Text="{Binding BrokerExecutionLabel}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Market data" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{Binding MarketDataStatusForeground}"
                                       FontSize="11" FontWeight="Bold"
                                       Text="{Binding MarketDataStateLabel}" />
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Journal" />
                            <TextBlock Grid.Column="1" Foreground="#5EE6B1" FontSize="11"
                                       FontWeight="Bold" Text="{Binding JournalStatus}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ACTIVITY JOURNAL" />
                        <ListBox Grid.Row="1" Margin="0,14,0,0" Padding="0"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding ActivityLog}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,9" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="#101925"
                                            BorderBrush="#243247" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#5F728A" FontFamily="Consolas"
                                                       FontSize="10" Text="{Binding Time}" />
                                            <TextBlock Grid.Column="1" Foreground="#B8C5D4" FontSize="11"
                                                       LineHeight="16" TextWrapping="Wrap"
                                                       Text="{Binding Message}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Padding="18,0"
                Background="#101721"
                BorderBrush="#243143"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#F4B45E" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#91A2B7"
                           FontSize="11"
                           Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="#53657B"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="{Binding VersionDisplay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
