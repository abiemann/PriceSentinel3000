<Window x:Class="PriceSentinel3000.App.Dialogs.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to PriceSentinel 3000"
        Width="590"
        Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0C1118">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="54"
                    Height="54"
                    HorizontalAlignment="Left"
                    Background="#123528"
                    BorderBrush="#5EE6B1"
                    BorderThickness="1"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#5EE6B1"
                           FontSize="25"
                           FontWeight="Bold"
                           Text="P" />
            </Border>
            <TextBlock Margin="0,18,0,0"
                       Foreground="#F8FAFC"
                       FontSize="25"
                       FontWeight="Bold"
                       Text="Welcome to PriceSentinel 3000" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Foreground="#CBD5E1"
                       FontSize="14"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Text="PriceSentinel needs a Robinhood Agentic Trading connection for real-time Paper Trader prices and historical Replay data. Without that connection, the app cannot monitor or replay prices." />
            <TextBlock Margin="0,15,0,0"
                       Foreground="#94A3B8"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Text="LOGIN uses Robinhood's secure browser authorization. PriceSentinel never asks for your Robinhood password, does not submit an order at startup, and opens in OFF mode after connecting." />

            <Border x:Name="StatusPanel"
                    Margin="0,18,0,0"
                    Padding="12,10"
                    Background="#101A26"
                    BorderBrush="#2A3A4E"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="LoginProgress"
                                 Width="62"
                                 Height="5"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="#5EE6B1" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#FB8B7B"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ExitButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="44"
                    Click="Exit_Click"
                    IsCancel="True"
                    Content="EXIT" />
            <Button x:Name="LoginButton"
                    Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="44"
                    Click="Login_Click"
                    IsDefault="True"
                    Content="LOGIN" />
        </Grid>
    </Grid>
</Window>
