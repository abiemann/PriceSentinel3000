<Window x:Class="PriceSentinel3000.App.Dialogs.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Welcome to PriceSentinel 3000"
        Width="590"
        Height="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False" />
        <Border Background="{StaticResource ChromeSurfaceBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SupportingTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="WELCOME TO PRICESENTINEL 3000" />
                <Button Grid.Column="1"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click"
                        Content="&#xE8BB;"
                        ToolTip="Close" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="54"
                    Height="54"
                    HorizontalAlignment="Left"
                    Background="{StaticResource BrandSurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="25"
                           FontWeight="Bold"
                           Text="P" />
            </Border>
            <TextBlock Margin="0,18,0,0"
                       Foreground="{StaticResource HeadingTextBrush}"
                       FontSize="25"
                       FontWeight="Bold"
                       Text="Welcome to PriceSentinel 3000" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Text="PriceSentinel needs a Robinhood Agentic Trading connection for real-time Paper Trader prices and historical Replay data. Without that connection, the app cannot monitor or replay prices." />
            <TextBlock Margin="0,15,0,0"
                       Foreground="{StaticResource SubduedTextBrush}"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Text="LOGIN opens Robinhood's secure authorization page. Finish any approval shown there and wait for the PriceSentinel completion message. The app opens safely in OFF mode." />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Border x:Name="StatusPanel"
                    Padding="12,11"
                    Background="#101A26"
                    BorderBrush="#2A3A4E"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="LoginProgress"
                                 Width="62"
                                 Height="5"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border x:Name="ErrorPanel"
                    Padding="12,10"
                    Background="#301C1B"
                    BorderBrush="#7F3C34"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource DangerHighlightBrush}"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ExitButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="44"
                    Click="Exit_Click"
                    IsCancel="True"
                    Content="EXIT" />
            <Button x:Name="LoginButton"
                    Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="44"
                    Click="Login_Click"
                    IsDefault="True"
                    Content="LOGIN" />
        </Grid>
        </Grid>
    </Grid>
</Window>
