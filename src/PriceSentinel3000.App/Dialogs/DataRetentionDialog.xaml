<Window x:Class="PriceSentinel3000.App.Dialogs.DataRetentionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Retain Hi-Res Data"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource ChromeSurfaceBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock Margin="14,0,46,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SupportingTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="TOOLS / RETAIN HI-RES DATA" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource CloseTitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="&#xE8BB;"
                            AutomationProperties.Name="Close Retain Hi-Res Data"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24">
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="24"
                           FontWeight="Bold"
                           Text="Retain Hi-Res Data" />
                <TextBlock Margin="0,8,0,20"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="Keep daily high-resolution market history for replay and strategy analysis." />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="AUTOMATIC DOWNLOADS: OFF" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Daily collection is not available in this build yet. Stock lists, Robinhood list import, and the download schedule will be configured here when collection is ready." />
                    </StackPanel>
                </Border>
                <Button Margin="0,20,0,0"
                        MinWidth="100"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click"
                        Content="CLOSE" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
