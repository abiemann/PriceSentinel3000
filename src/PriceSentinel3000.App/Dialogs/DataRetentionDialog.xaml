<Window x:Class="PriceSentinel3000.App.Dialogs.DataRetentionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:dialogs="clr-namespace:PriceSentinel3000.App.Dialogs"
 xmlns:controls="clr-namespace:PriceSentinel3000.App.Controls"
 xmlns:converters="clr-namespace:PriceSentinel3000.App.Converters"
 Title="Retain Hi-Res Data" Width="1080" Height="790" MinWidth="860" MinHeight="620" WindowStyle="None"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryTextBrush}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /></Style>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
  <converters:DatasetSessionCoverageConverter x:Key="DatasetSessionCoverage" />
  <Style x:Key="DatasetCoverageCell" TargetType="TextBlock">
   <Setter Property="ToolTip" Value="{Binding Converter={StaticResource DatasetSessionCoverage}, ConverterParameter=Details}" />
  </Style>
  <Style x:Key="DownloadStateText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" />
   <Style.Triggers><DataTrigger Binding="{Binding DownloadState}" Value="Attention"><Setter Property="Foreground" Value="#E8AB4D" /></DataTrigger><DataTrigger Binding="{Binding DownloadState}" Value="Paused"><Setter Property="Foreground" Value="#E8AB4D" /></DataTrigger><DataTrigger Binding="{Binding DownloadState}" Value="Idle"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="DownloadCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="ToolTip" Value="{Binding DetailsText}" /></Style>
  <Style x:Key="DownloadCoverageCell" TargetType="TextBlock" BasedOn="{StaticResource DownloadCell}"><Setter Property="ToolTip" Value="{Binding StateToolTip}" /><Setter Property="AutomationProperties.HelpText" Value="{Binding StateToolTip}" /></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="TabBorder" Background="{StaticResource CardBrush}" Padding="20,12" Margin="0,0,4,0" CornerRadius="6,6,0,0"><ContentPresenter ContentSource="Header" /></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SuccessSurfaceBrush}" /></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="LibraryColumnHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{StaticResource HeaderSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="Padding" Value="8" />
   <Setter Property="ToolTip" Value="Click to sort. Shift-click to add or reverse a secondary sort. Arrow numbers show priority: 1 first, then 2." />
   <Setter Property="AutomationProperties.HelpText" Value="Click to sort. Shift-click adds a secondary sort. Arrow numbers show sort priority." />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
    <Grid>
     <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><ContentPresenter VerticalAlignment="Center" /><TextBlock x:Name="LibrarySortIndicator" Text="{Binding Column.(dialogs:DataRetentionDialog.SortIndicator), RelativeSource={RelativeSource TemplatedParent}}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10" TextWrapping="NoWrap" Foreground="{StaticResource AccentBrush}" /></StackPanel></Border>
     <Thumb x:Name="PART_LeftHeaderGripper" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" />
     <Thumb x:Name="PART_RightHeaderGripper" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" />
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="SortDirection" Value="{x:Null}"><Setter TargetName="LibrarySortIndicator" Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /></Trigger>
     <DataTrigger Binding="{Binding Column.CanUserSort, RelativeSource={RelativeSource Self}}" Value="False"><Setter TargetName="LibrarySortIndicator" Property="Visibility" Value="Collapsed" /></DataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding Column.CanUserSort, RelativeSource={RelativeSource Self}}" Value="False"><Setter Property="ToolTip" Value="{x:Null}" /><Setter Property="AutomationProperties.HelpText" Value="" /></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="LibraryGrid" TargetType="DataGrid">
   <Setter Property="Background" Value="{StaticResource WindowBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Setter Property="RowBackground" Value="{StaticResource CardBrush}" /><Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBrush}" />
   <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" /><Setter Property="GridLinesVisibility" Value="None" /><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="RowHeight" Value="32" />
   <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource HeaderSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="Padding" Value="8" /></Style></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border Background="{StaticResource ChromeSurfaceBrush}" CornerRadius="8,8,0,0"><Grid>
   <TextBlock Margin="14,0,46,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="TOOLS / RETAIN HI-RES DATA" />
   <Button HorizontalAlignment="Right" Style="{StaticResource CloseTitleBarButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" Content="&#xE8BB;" AutomationProperties.Name="Close Retain Hi-Res Data" ToolTip="Close" />
  </Grid></Border>
  <StackPanel Grid.Row="1" Margin="24,12,24,12"><TextBlock FontSize="25" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="Retain Hi-Res Data" />
   <TextBlock Margin="0,4,0,0" FontSize="12"><Run FontWeight="SemiBold" Text="Saved schedule: " /><Run Text="{Binding SavedSchedule, Mode=OneWay}" /></TextBlock>
  </StackPanel>
  <Border x:Name="DownloadActivityCard" Grid.Row="2" Margin="24,0,24,10" Padding="12,8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="Download activity">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
    <StackPanel>
     <DockPanel HorizontalAlignment="Left">
      <Button x:Name="DownloadInfoButton" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,6,0" Padding="0" FontSize="11"
              Style="{StaticResource SecondaryButtonStyle}" Content="i" AutomationProperties.Name="Download information"
              AutomationProperties.HelpText="Hover or click to open download information. Scroll inside; click outside or press Escape to close."
              MouseEnter="DownloadInfo_MouseEnter" Click="DownloadInfo_Click" />
      <TextBlock x:Name="DownloadActivityHeading" Style="{StaticResource DownloadStateText}" FontSize="13"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding DownloadHeading}" AutomationProperties.LiveSetting="Polite" />
     </DockPanel>
     <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding JobSummary}" />
     <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                  Foreground="{StaticResource AccentBrush}" Background="{StaticResource WindowBrush}" AutomationProperties.Name="Download jobs checked" AutomationProperties.HelpText="{Binding JobSummary}" />
    </StackPanel>
    <Button x:Name="PauseDownloadsButton" Grid.Column="2" Height="32" VerticalAlignment="Center" Padding="8,4" Content="{Binding PauseDownloadsLabel}"
            Command="{Binding PauseDownloadsCommand}" AutomationProperties.Name="{Binding PauseDownloadsLabel}" ToolTip="Pause or resume background downloads. Saved candles are preserved.">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <Button x:Name="CancelConnectionButton" Grid.Column="2" Height="32" VerticalAlignment="Center" Padding="8,4" Style="{StaticResource SecondaryButtonStyle}"
            Content="CANCEL CONNECTION" Command="{Binding CancelDownloadsCommand}" Visibility="{Binding IsConnecting, Converter={StaticResource BooleanVisibility}}" ToolTip="Cancel the current Robinhood connection request." />
   </Grid>
  </Border>
  <TabControl x:Name="RetentionTabs" Grid.Row="3" Margin="24,0,24,12" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource SubtleBorderBrush}">
   <TabItem Header="EQUITY LISTS"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Style="{StaticResource SectionLabelStyle}" Text="YOUR DOWNLOAD LISTS" />
     <ComboBox Margin="0,10,0,8" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" DisplayMemberPath="Name" AutomationProperties.Name="Saved download lists" />
     <TextBlock Margin="0,0,0,8" FontSize="11" Text="{Binding ListSummary}" />
     <WrapPanel><Button Style="{StaticResource SecondaryButtonStyle}" Content="NEW LIST" Command="{Binding NewListCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="REMOVE LIST" Command="{Binding DeleteListCommand}" /></WrapPanel>
     <TextBlock Margin="0,20,0,5" Text="List name" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding ListName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Download list name" />
     <CheckBox Margin="0,10,0,14" Style="{StaticResource PaperCheckBoxStyle}" Content="Include this list in downloads" IsChecked="{Binding ListEnabled}" />
     <TextBlock Text="Add symbols (spaces or commas)" /><TextBox Margin="0,6,0,8" Style="{StaticResource InputTextBoxStyle}" Text="{Binding TickerInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Equity symbols to add" />
     <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="ADD EQUITIES" Command="{Binding AddTickersCommand}" />
     <TextBlock Margin="0,24,0,10" Style="{StaticResource SectionLabelStyle}" Text="IMPORT FROM ROBINHOOD" />
     <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="LOAD ROBINHOOD LISTS" Command="{Binding LoadWatchlistsCommand}" />
     <ComboBox Margin="0,8,0,8" Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding RobinhoodLists}" SelectedItem="{Binding SelectedRobinhoodList}" DisplayMemberPath="Name" AutomationProperties.Name="Robinhood list to import" />
     <WrapPanel><Button Style="{StaticResource SecondaryButtonStyle}" Content="PREVIEW IMPORT" Command="{Binding ImportWatchlistCommand}" Margin="0,0,8,8" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="REFRESH SOURCE" Command="{Binding RefreshWatchlistCommand}" Margin="0,0,0,8" /></WrapPanel>
     <TextBlock Margin="0,8,0,0" FontSize="12" Text="Imports create editable local copies. Choose individual equities on the right and save. Refresh previews changes and preserves exclusions." />
    </StackPanel></ScrollViewer>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Style="{StaticResource SectionLabelStyle}" Text="EQUITIES TO INCLUDE" Margin="0,0,0,10" />
     <ListBox Grid.Row="1" Margin="0,0,0,12" ItemsSource="{Binding Members}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8" /></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource PaperCheckBoxStyle}" IsChecked="{Binding IsIncluded}" ToolTip="{Binding CompanyName}">
       <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Run Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" Text="{Binding Symbol, Mode=OneWay}" /><Run Text="   " /><Run FontSize="11" Text="{Binding CompanyName, Mode=OneWay}" /></TextBlock>
      </CheckBox></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button x:Name="SaveListButton" Grid.Row="2" Margin="0,0,0,10" Style="{StaticResource PrimaryButtonStyle}"
             Content="{Binding SaveListButtonText}" Command="{Binding SaveListCommand}"
             Visibility="{Binding ShowSaveListButton, Converter={StaticResource BooleanVisibility}}"
             IsVisibleChanged="SaveListButton_IsVisibleChanged" AutomationProperties.Name="{Binding SaveListButtonText}">
      <Button.RenderTransform><TranslateTransform /></Button.RenderTransform>
     </Button>
     <WrapPanel Grid.Row="3"><Button Style="{StaticResource SecondaryButtonStyle}" Content="IMPORT LIST FILE" Click="ImportListFile_Click" IsEnabled="{Binding CanEditPlan}" Margin="0,0,8,0" /><Button x:Name="ExportListsButton" Style="{StaticResource SecondaryButtonStyle}" Content="EXPORT LISTS" Click="ExportLists_Click" IsEnabled="{Binding CanEditPlan}" Visibility="{Binding HasSavedLists, Converter={StaticResource BooleanVisibility}}" ToolTip="Save all saved list names, symbols and checkbox settings to a file for backup or import into PriceSentinel." /></WrapPanel>
    </Grid>
   </Grid></TabItem>
   <TabItem x:Name="ScheduleDownloadsTab" Header="SCHEDULE &amp; DOWNLOADS"><Grid Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="230" /><ColumnDefinition Width="20" /><ColumnDefinition Width="5*" /></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <CheckBox Style="{StaticResource PaperCheckBoxStyle}" Content="Enable automatic daily downloads" IsChecked="{Binding AutomaticDownloadsEnabled}" />
     <TextBlock x:Name="UnsavedScheduleWarning" Margin="0,8,0,0" FontSize="12" Foreground="#E8AB4D" Text="{Binding ScheduleChangesText}" Visibility="{Binding HasScheduleChanges, Converter={StaticResource BooleanVisibility}}" AutomationProperties.LiveSetting="Polite" />
     <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="RECONNECT ROBINHOOD" Command="{Binding ReconnectCommand}" ToolTip="Renew authorization while trading and downloads are idle" />
     <TextBlock Margin="0,16,0,6" Text="Time of day (24-hour HH:mm)" /><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding DailyTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Daily download time" />
     <TextBlock Margin="0,12,0,6" Text="Time zone" /><ComboBox Style="{StaticResource InputComboBoxStyle}" ItemsSource="{Binding TimeZones}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" SelectedValue="{Binding TimeZoneId}" AutomationProperties.Name="Daily download time zone" />
     <TextBlock Margin="0,12,0,6" Text="Library folder" />
     <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding LibraryRootPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Market data library folder" />
      <Button Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Content="..." Click="BrowseLibraryFolder_Click" ToolTip="Browse for a market data library folder" AutomationProperties.Name="Browse for market data library folder" />
     </Grid>
     <Button Margin="0,12,0,8" Style="{StaticResource PrimaryButtonStyle}" Content="SAVE SCHEDULE &amp; FOLDER" Command="{Binding SaveScheduleCommand}" />
    </StackPanel></ScrollViewer>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="DownloadAvailableButton" Style="{StaticResource PrimaryButtonStyle}" Content="DOWNLOAD GAPS NOW" Command="{Binding DownloadNowCommand}" />
      <Button x:Name="ForcedDownloadButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="FORCED DOWNLOAD" Command="{Binding ForcedDownloadCommand}" ToolTip="Retry missing candles with a fresh retry count, including ranges previously reported as unavailable. Saved candles are reused." />
      <Button x:Name="ClearDownloadQueueButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="CLEAR" Command="{Binding ClearDownloadQueueCommand}" ToolTip="Clear finished queue entries. Saved candles and remembered gaps are kept." AutomationProperties.Name="Clear finished download queue" />
     </StackPanel>
     <DataGrid x:Name="DownloadJobsGrid" Grid.Row="1" Style="{StaticResource LibraryGrid}" ColumnHeaderStyle="{StaticResource LibraryColumnHeader}" Loaded="DownloadJobsGrid_Loaded" Unloaded="DownloadJobsGrid_Unloaded" ItemsSource="{Binding VisibleJobs}" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Download queue">
      <DataGrid.Columns><DataGridTextColumn Header="Equity" Binding="{Binding Symbol}" SortMemberPath="Symbol" Width="100" ElementStyle="{StaticResource DownloadCell}" /><DataGridTextColumn Header="Date" Binding="{Binding SessionDate, StringFormat=yyyy-MM-dd}" SortMemberPath="SessionDate" Width="87" ElementStyle="{StaticResource DownloadCell}" /><DataGridTextColumn Header="State" Binding="{Binding StateText}" SortMemberPath="StateCoveragePercent" Width="92" ElementStyle="{StaticResource DownloadCoverageCell}" /><DataGridTextColumn Header="Details" Binding="{Binding DetailsText}" CanUserSort="False" Width="*" MinWidth="100" ElementStyle="{StaticResource DownloadCell}" /></DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Grid></TabItem>
   <TabItem x:Name="LocalLibraryTab" Header="LOCAL LIBRARY"><Grid Margin="16,8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Grid Margin="0,0,8,0">
     <Button x:Name="RescanLibraryButton" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ScanLibraryCommand}" AutomationProperties.Name="{Binding LibraryScanButtonText}" ToolTip="Scan saved history, including files copied into the library.">
      <TextBlock Text="RESCAN LIBRARY" TextWrapping="NoWrap" Foreground="{StaticResource PrimaryTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsLibraryScanning}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Button>
     <TextBlock x:Name="LibraryScanProgressText" Text="{Binding LibraryScanButtonText}" Visibility="{Binding IsLibraryScanning, Converter={StaticResource BooleanVisibility}}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" FontSize="11" FontWeight="SemiBold" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource PrimaryTextBrush}" />
     </Grid><Button Style="{StaticResource SecondaryButtonStyle}" Content="OPEN FOLDER" Command="{Binding OpenFolderCommand}" ToolTip="Open the saved market data library folder." /></StackPanel>
     <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontSize="11" Text="Click a row for coverage. Click a column to sort; Shift-click adds a secondary sort." />
     <TextBlock x:Name="LibrarySizeText" Grid.Column="2" MinWidth="100" Text="{Binding LibrarySizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" AutomationProperties.Name="Saved library file size" ToolTip="Size of active saved candle files from the latest scan. 1 MB = 1,000,000 bytes." />
    </Grid>
    <DataGrid x:Name="LocalLibraryGrid" Grid.Row="1" FocusVisualStyle="{x:Null}" PreviewMouseLeftButtonUp="LocalLibraryGrid_MouseLeftButtonUp" PreviewKeyDown="LocalLibraryGrid_KeyDown" Style="{StaticResource LibraryGrid}" ColumnHeaderStyle="{StaticResource LibraryColumnHeader}" Loaded="LocalLibraryGrid_Loaded" Unloaded="LocalLibraryGrid_Unloaded" ItemsSource="{Binding VisibleLibraryDays}" SelectedItem="{Binding SelectedLibraryDay}" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saved market data"><DataGrid.Resources>
     <Style TargetType="DataGridRow">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Trigger></Style.Triggers>
     </Style>
     <Style TargetType="DataGridCell">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Trigger></Style.Triggers>
     </Style>
    </DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Equity" SortMemberPath="Symbol" Binding="{Binding Symbol}" Width="100" /><DataGridTextColumn Header="Date" SortMemberPath="TradingDate" Binding="{Binding TradingDate, StringFormat=yyyy-MM-dd}" Width="120" /><DataGridTextColumn Header="Day coverage" SortMemberPath="CoveragePercent" Binding="{Binding Converter={StaticResource DatasetSessionCoverage}, Mode=OneWay}" ElementStyle="{StaticResource DatasetCoverageCell}" Width="140" /><DataGridTextColumn Header="Candles" SortMemberPath="CandleCount" Binding="{Binding CandleCount, TargetNullValue=--}" Width="100" /><DataGridTextColumn Header="Provider" SortMemberPath="Provider" Binding="{Binding Provider}" Width="*" MinWidth="100" /></DataGrid.Columns></DataGrid>
    <Expander x:Name="LibraryDiagnosticsExpander" Grid.Row="2" Margin="0,8,0,0" Header="LIBRARY DETAILS" IsExpanded="False" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{Binding HasLibraryDiagnostics, Converter={StaticResource BooleanVisibility}}">
     <TextBox x:Name="LibraryDiagnosticsText" Margin="0,6,0,0" Padding="8" MaxHeight="90" IsReadOnly="True" Text="{Binding LibraryDiagnostics, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource WindowBrush}" Foreground="{StaticResource SecondaryTextBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" AutomationProperties.Name="Library scan details" />
    </Expander>
   </Grid></TabItem>
  </TabControl>
  <Border Grid.Row="4" Background="{StaticResource HeaderSurfaceBrush}" Padding="24,8"><TextBlock x:Name="StatusSummaryText" MaxHeight="18" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.ToolTip><ToolTip><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><TextBlock MaxWidth="420" Text="{Binding Status}" TextWrapping="Wrap" /></ScrollViewer></ToolTip></TextBlock.ToolTip></TextBlock></Border>
  <Popup x:Name="DownloadInfoPopup" PlacementTarget="{Binding ElementName=DownloadInfoButton}" Placement="Bottom"
         VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
   <Border x:Name="DownloadInfoPanel" Width="480" Padding="14" Background="{StaticResource CardBrush}"
           BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6"
           KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="DownloadInfo_KeyDown" AutomationProperties.Name="Download information">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel>
      <Button x:Name="DownloadInfoCloseButton" DockPanel.Dock="Right" Width="24" Height="24" Padding="0" FontSize="18"
              Style="{StaticResource SecondaryButtonStyle}" Content="×" Click="DownloadInfoClose_Click" AutomationProperties.Name="Close download information" />
      <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding DownloadHeading}" />
     </DockPanel>
     <ScrollViewer x:Name="DownloadInfoScrollViewer" Grid.Row="1" Margin="0,10,0,0" MaxHeight="360"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock x:Name="DownloadActivityDetail" FontSize="12" Margin="0,6,0,0" Text="{Binding DownloadDetail}" />
       <TextBlock x:Name="DownloadActivityTiming" FontSize="11" Margin="0,6,0,0" Text="{Binding DownloadTiming}" />
       <TextBlock x:Name="DownloadInteractionGuidance" FontSize="12" Margin="0,10,0,0" Text="{Binding DownloadInteractionHint}" />
       <Separator Margin="0,12" />
       <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="How downloads work" />
       <TextBlock x:Name="DownloadAvailableGuidance" Margin="0,6,0,0" FontSize="12" Text="Queue today, then check older days. Saved candles are reused. Older gaps get two attempts, recorded in the daily JSON; Forced download can recheck them. Today's unavailable ranges can be retried after 15 minutes." />
       <TextBlock x:Name="DownloadCoverageGuidance" Margin="0,10,0,0" FontSize="12" Text="All available trading hours, including overnight. Only completed 15-second candles are saved. Market closures are excluded from expected coverage." />
       <TextBlock x:Name="ScheduleHelpText" Margin="0,10,0,0" FontSize="12" Text="{Binding ScheduleHelp}" />
       <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding ContinuityWarnings}" />
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Popup>
  <Grid x:Name="LibraryCoverageOverlay" Grid.RowSpan="5" Panel.ZIndex="10" Background="#B0000000"
        Visibility="Collapsed" MouseUp="LibraryCoverageOverlay_MouseUp" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Border x:Name="LibraryCoverageCard" Margin="24" Padding="24" MaxWidth="1000" VerticalAlignment="Center"
           Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
           BorderThickness="1" CornerRadius="12" KeyboardNavigation.TabNavigation="Cycle"
           KeyboardNavigation.ControlTabNavigation="Cycle" AutomationProperties.Name="Daily data coverage dialog">
    <StackPanel>
     <DockPanel Margin="0,0,0,16">
      <Button x:Name="LibraryCoverageCloseButton" DockPanel.Dock="Right" Width="36" Height="36" Padding="0"
              Style="{StaticResource SecondaryButtonStyle}" Content="×" FontSize="22"
              Click="LibraryCoverageClose_Click" ToolTip="Close coverage" AutomationProperties.Name="Close coverage dialog" />
      <TextBlock x:Name="LibraryCoverageCloseHint" DockPanel.Dock="Right" Margin="12,0,12,0" VerticalAlignment="Center"
                 FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="Click outside or press Esc to close." />
      <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="SAVED DATA COVERAGE" />
       <TextBlock x:Name="LibraryCoverageTitle" Margin="0,4,12,0" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
      </StackPanel>
     </DockPanel>
     <TextBlock x:Name="LibraryCoverageMessage" Margin="0,12,0,24" Text="Loading saved coverage…" />
     <StackPanel x:Name="LibraryCoverageContent">
      <WrapPanel Margin="0,0,0,4"><TextBlock Text="{Binding RangeLabel}" Margin="0,0,12,0" />
       <TextBlock Text="{Binding TimeZoneLabel}" Foreground="{StaticResource AccentBrush}" /></WrapPanel>
      <TextBlock Text="{Binding Summary}" Margin="0,0,0,16" Foreground="{StaticResource PrimaryTextBrush}" />
      <controls:LibraryCoverageTimelineControl x:Name="LibraryCoverageTimeline" Timeline="{Binding}" BlockSelectionChanged="LibraryCoverageBlockSelectionChanged" Height="104" MinWidth="600" />
      <WrapPanel x:Name="LibraryCoverageLegend" Margin="28,12,0,8">
       <StackPanel Orientation="Horizontal" Margin="0,0,20,8"><Border Background="#24BD83" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="Complete" /></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,20,8"><Border Background="#000000" BorderBrush="#61788A" BorderThickness="1" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="Missing" /></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,20,8"><Border Background="#A8EDBD" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="Partial" /></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,20,8"><Border x:Name="LibraryCoverageClosedKey" Background="#334155" Width="14" Height="14" Margin="0,0,7,0" ClipToBounds="True"><Path Stroke="#8292A5" StrokeThickness="1" Data="M -6,14 L 8,0 M 2,14 L 16,0 M 10,14 L 24,0" /></Border><TextBlock Text="Market closed" /></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border x:Name="LibraryCoverageFutureKey" Background="#173B5C" BorderBrush="#61788A" BorderThickness="1" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="Future" /></StackPanel>
      </WrapPanel>
      <Border x:Name="LibraryCoverageBlockPanel" Height="80" Padding="10,8"
              Background="{StaticResource HeaderSurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Text="SELECTED BLOCK" />
        <TextBlock x:Name="LibraryCoverageBlockDetails" Grid.Row="1" Margin="0,4,12,0" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryTextBrush}"
                   Text="{Binding SelectedBlock.ToolTip, ElementName=LibraryCoverageTimeline, TargetNullValue=Click a 15-minute block for details., FallbackValue=Click a 15-minute block for details.}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="LibraryCoverageDownloadStatus" Grid.Row="2" Grid.ColumnSpan="2" Height="14" Margin="0,2,0,0"
                   VerticalAlignment="Bottom" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" Text=""
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Button x:Name="LibraryCoverageDownloadButton" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                Height="30" MinWidth="92" Padding="10,4" Content="DOWNLOAD" FontSize="11"
                Click="LibraryCoverageDownload_Click"
                IsEnabled="{Binding DataContext.CanDownloadCoverage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                ToolTip="Retry this block and adjacent missing blocks. Saved candles are kept; future time is excluded."
                AutomationProperties.Name="Download connected missing blocks">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers><DataTrigger Binding="{Binding SelectedBlock.State, ElementName=LibraryCoverageTimeline}" Value="Missing">
           <Setter Property="Visibility" Value="Visible" />
          </DataTrigger></Style.Triggers>
         </Style></Button.Style>
        </Button>
       </Grid>
      </Border>
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers>
        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        <DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid></Border>
</Window>
