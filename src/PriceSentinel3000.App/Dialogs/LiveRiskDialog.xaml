<Window x:Class="PriceSentinel3000.App.Dialogs.LiveRiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIVE trading warning"
        Width="540"
        Height="390"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#10151D">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Border Width="54"
                    Height="54"
                    HorizontalAlignment="Left"
                    Background="#3A201D"
                    BorderBrush="#F97360"
                    BorderThickness="1"
                    CornerRadius="27">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FB8B7B"
                           FontSize="26"
                           FontWeight="Bold"
                           Text="!" />
            </Border>
            <TextBlock Margin="0,20,0,0"
                       Foreground="#F8FAFC"
                       FontSize="25"
                       FontWeight="Bold"
                       Text="LIVE trading can lose money" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,20,0,0">
            <TextBlock Foreground="#CBD5E1"
                       FontSize="14"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Text="LIVE mode can submit real orders using funds in your Robinhood Agentic account. Prices can move before an order fills, automated decisions can be wrong, and losses may exceed expectations." />
            <TextBlock Margin="0,16,0,0"
                       Foreground="#94A3B8"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Text="Stage 2 does not connect to Robinhood or arm LIVE execution. Agreeing records the warning acknowledgment only." />
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Height="44"
                    Background="#202A37"
                    BorderBrush="#3B4A5E"
                    BorderThickness="1"
                    Click="Cancel_Click"
                    Foreground="#E2E8F0"
                    FontWeight="SemiBold"
                    IsCancel="True"
                    Content="CANCEL" />
            <Button Grid.Column="2"
                    Height="44"
                    Background="#D85545"
                    BorderBrush="#F97360"
                    BorderThickness="1"
                    Click="Agree_Click"
                    Foreground="White"
                    FontWeight="Bold"
                    IsDefault="True"
                    Content="I AGREE" />
        </Grid>
    </Grid>
</Window>
