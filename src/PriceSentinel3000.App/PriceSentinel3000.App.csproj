<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PriceSentinel3000.Application\PriceSentinel3000.Application.csproj" />
    <ProjectReference Include="..\PriceSentinel3000.Core\PriceSentinel3000.Core.csproj" />
    <ProjectReference Include="..\PriceSentinel3000.Infrastructure\PriceSentinel3000.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PriceSentinel3000</AssemblyName>
    <ApplicationIcon>Assets\PriceSentinel3000.ico</ApplicationIcon>
    <Product>PriceSentinel 3000</Product>
    <AssemblyTitle>PriceSentinel 3000</AssemblyTitle>
    <Authors>Alexander R. Biemann</Authors>
    <Company>Alexander R. Biemann</Company>
    <Description>A guarded Windows workspace for market monitoring, replay, paper trading, and experimental live execution.</Description>
    <Copyright>Copyright (c) 2026 Alexander R. Biemann</Copyright>
    <Version Condition="'$(PriceSentinelPackageVersion)' == ''">1.0.0</Version>
  </PropertyGroup>

</Project>
