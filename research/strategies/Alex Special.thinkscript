# PriceSentinel: tested-candle-seconds=15
# Alex Special: simple RSI(14), matching the PriceSentinel chart at 15 seconds.
# Buy when RSI is 10 or below, or on the third separate crossing below 30
# since RSI last reached 60. Remaining below 30 is one dip, not several.
# Sell at RSI 60 or above. Reaching 60 resets the dip count.
# CountSince is a PriceSentinel extension; this file needs the updated app.
# Counts start with the available history and reset after a data gap/new session.
# Reference tests use synthetic 15-second candles; no profitability claim.
# Applies to the selected equity. The host owns sizing, fills and risk exits.
input rsiLength = 14;
input buyRsi = 10;
input dipRsi = 30;
input exitRsi = 60;

def strength = RSI(length = rsiLength, price = close, averageType = AverageType.SIMPLE);
def dipBelow30 = strength crosses below dipRsi;
def dipCount = CountSince(condition = dipBelow30, reset = strength >= exitRsi);
def deepDip = strength <= buyRsi;
def thirdDip = dipBelow30 and dipCount == 3;
def exitLong = strength >= exitRsi;

AddOrder(OrderType.BUY_TO_OPEN, deepDip, name = "RSI 10 or below");
AddOrder(OrderType.BUY_TO_OPEN, thirdDip, name = "Third dip below RSI 30");
AddOrder(OrderType.SELL_TO_CLOSE, exitLong, name = "RSI 60 or above");
